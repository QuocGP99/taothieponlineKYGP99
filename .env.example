# GP STUDIO99 – YEARBOOK INVITATION MAKER
# Tích hợp chupanhdanang.com

# 1. Cấu hình gửi Email thực tế qua Resend (Khuyên dùng)
# Lấy API Key tại: https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="GP Studio99 <thiepmoi@chupanhdanang.com>"

# 2. Cấu hình Supabase (Tùy chọn nếu muốn chuyển từ JSON DB sang Supabase Cloud)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Domain cấu hình
NEXT_PUBLIC_SITE_URL=https://chupanhdanang.com
