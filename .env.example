# --------------------------------------------------------
# 1. CẤU HÌNH PRISMA POSTGRESQL (VERCEL POSTGRES / NEON / SUPABASE)
# --------------------------------------------------------
# Chuỗi kết nối PostgreSQL (dành cho Vercel / Neon / Supabase):
DATABASE_URL="postgresql://postgres:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://postgres:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------
# 2. CẤU HÌNH GỬI EMAIL THỰC TẾ QUA SMTP (CHỌN 1 TRONG 2 CÁCH)
# --------------------------------------------------------

# CÁCH A: Dùng Webmail / OxMail SMTP của iNET (Theo gói email taothiepkyyeugp99.io.vn)
SMTP_HOST=mail.taothiepkyyeugp99.io.vn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lienhe@taothiepkyyeugp99.io.vn
SMTP_PASSWORD=MatKhauHopThu_lienhe_CuaBan

# CÁCH B: Hoặc dùng Gmail SMTP cá nhân (Tạo Mật khẩu ứng dụng 16 ký tự)
# Hướng dẫn: Bật 2FA -> Truy cập https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# --------------------------------------------------------
# 3. TÊN MIỀN & MÔI TRƯỜNG PRODUCTION
# --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://chupanhdanang.com
PORT=3000
NODE_ENV=production

# --------------------------------------------------------
# 4. CẤU HÌNH ĐĂNG NHẬP GOOGLE OAUTH 2.0 (GOOGLE IDENTITY SERVICES)
# --------------------------------------------------------
# Tạo miễn phí tại: https://console.cloud.google.com/
# Vào: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID (Web application)
# Authorized JavaScript origins: https://chupanhdanang.com, http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
